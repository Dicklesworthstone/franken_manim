  "driver_source": "//! Diagnostic driver linked against the actual fmn-output and fmn-codec rlibs.\n//! The caller supplies the original WAV and exact portal timeline parameters.\n//! This isolates native audio work; it is not an end-to-end portal benchmark.\nuse std::{env, error::Error, fs, time::Instant};\n\nuse fmn_codec::{SampleFormat, WavLimits, decode_wav};\nuse fmn_output::{DitherPolicy, MixerConfig, SoundCue, SoundMixer};\n\nfn main() -> Result<(), Box<dyn Error>> {\n    let args: Vec<String> = env::args().collect();\n    if args.len() != 6 {\n        return Err(\"usage: benchmark_original_audio INPUT.wav OUTPUT.wav THREADS TIMELINE_SAMPLES FPS\".into());\n    }\n    let threads: usize = args[3].parse()?;\n    let timeline: u64 = args[4].parse()?;\n    let fps: u32 = args[5].parse()?;\n    let total = Instant::now();\n    let input = fs::read(&args[1])?;\n    let audio = decode_wav(&input, &WavLimits::default())?;\n    let decode_ns = total.elapsed().as_nanos();\n    let input_rate = audio.sample_rate;\n    let input_channels = audio.channels;\n    let input_frames = audio.samples.len() / usize::from(input_channels);\n    let mut mixer = SoundMixer::new(MixerConfig::default())?.with_timeline_frames(timeline);\n    let start = Instant::now();\n    mixer.add(SoundCue::new(audio, 0, fps))?;\n    let prepare_ns = start.elapsed().as_nanos();\n    let start = Instant::now();\n    let report = mixer.mix(threads)?;\n    let mix_ns = start.elapsed().as_nanos();\n    let start = Instant::now();\n    let wav = report.wav_bytes(SampleFormat::S16, DitherPolicy::None)?;\n    let encode_ns = start.elapsed().as_nanos();\n    let total_ns = total.elapsed().as_nanos();\n    fs::write(&args[2], &wav)?;\n    println!(\n        \"{{\\\"schema_version\\\":1,\\\"input_sample_rate\\\":{input_rate},\\\"input_channels\\\":{input_channels},\\\"input_frames\\\":{input_frames},\\\"output_sample_rate\\\":{},\\\"output_channels\\\":{},\\\"output_frames\\\":{},\\\"threads\\\":{threads},\\\"workers_used\\\":{},\\\"decode_ns\\\":{decode_ns},\\\"prepare_ns\\\":{prepare_ns},\\\"mix_ns\\\":{mix_ns},\\\"encode_ns\\\":{encode_ns},\\\"total_ns\\\":{total_ns},\\\"wav_bytes\\\":{}}}\",\n        report.audio.sample_rate,\n        report.audio.channels,\n        report.audio.samples.len() / usize::from(report.audio.channels),\n        report.workers_used,\n        wav.len(),\n    );\n    Ok(())\n}\n",
